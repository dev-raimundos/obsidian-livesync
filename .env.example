# Copie para .env no uso local ou para Environment no Dokploy.
# Não envie o .env com suas credenciais para o Git.

# Usuário administrador do CouchDB (obrigatório).
# Use também este usuário nas configurações do plugin Self-hosted LiveSync.
COUCHDB_USER=livesync_admin

# Senha do administrador (obrigatória; o deploy falha se estiver vazia).
# Gere uma senha forte, por exemplo: openssl rand -hex 32
# Prefira hexadecimal para evitar a interpolação de $ pelo Docker Compose.
COUCHDB_PASSWORD=

# Banco do vault, criado automaticamente na inicialização.
# Informe o mesmo nome no plugin do Obsidian.
# Comece com letra minúscula; use a-z, 0-9 ou os caracteres _ $ ( ) + -.
# Alterar este valor cria outro banco; não migra os dados anteriores.
COUCHDB_DATABASE=obsidiannotes

# Porta HTTP publicada no servidor. Altere se 5984 já estiver ocupada.
# A porta interna do container permanece 5984: use-a no domínio do Dokploy.
# Com HTTPS pelo domínio, a URL do plugin será https://sync.seudominio.com.
COUCHDB_PORT=5984

# Interface do servidor na qual a porta HTTP será publicada.
# 0.0.0.0: permite acesso direto pelo IP, conforme as regras da rede/firewall.
# 127.0.0.1: restringe o HTTP direto ao próprio servidor (recomendado se usar
# somente o domínio HTTPS do Dokploy; o Traefik acessa pela rede Docker).
COUCHDB_BIND_ADDRESS=0.0.0.0
